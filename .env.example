# F-Forum Real OAuth Configuration
# Google OAuth 2.0 (Google Identity Services)
# Create a Web OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Meta / Facebook JavaScript SDK (v20.0)
# Create a Facebook App at https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=

# ---------------------------------------------------------------------------
# Bảo mật máy chủ (tuỳ chọn — server tự sinh nếu bỏ trống)
# ---------------------------------------------------------------------------
# Khoá HMAC dùng ký token phiên. Nên đặt cố định ở môi trường thật để token
# không mất hiệu lực mỗi lần khởi động lại. Tối thiểu 16 ký tự.
FFORUM_SESSION_SECRET=

# Thư mục lưu dữ liệu (mặc định: ./data). Test dùng thư mục tạm riêng.
FFORUM_DATA_DIR=

# Credential OAuth phía MÁY CHỦ — dùng để tự kiểm chứng đăng nhập Google/Facebook.
# Không có chúng thì tài khoản vẫn đăng nhập social được ở chế độ demo,
# nhưng quyền Super Admin thì BẮT BUỘC phải xác minh thành công.
FFORUM_GOOGLE_CLIENT_ID=
FFORUM_FACEBOOK_APP_ID=
FFORUM_FACEBOOK_APP_SECRET=

# Đặt 1 NẾU server đứng sau reverse proxy (nginx, Cloudflare Tunnel...).
# Khi đó IP dùng cho rate limit lấy từ header X-Forwarded-For.
# Để trống (mặc định) thì dùng địa chỉ socket thật, client không giả được.
FFORUM_TRUST_PROXY=
