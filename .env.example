# F-Forum Real OAuth Configuration
# Google OAuth 2.0 (Google Identity Services)
# Create a Web OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Meta / Facebook JavaScript SDK (v20.0)
# Create a Facebook App at https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=

# ---------------------------------------------------------------------------
# Bảo mật máy chủ
# ---------------------------------------------------------------------------
# Mật khẩu bootstrap Super Admin khi cài mới. Server bắt buộc tối thiểu 12 ký tự
# (ngắn hơn sẽ bị bỏ qua); khuyến nghị ≥ 16 ký tự, tạo ngẫu nhiên riêng cho môi
# trường thật; server chỉ lưu bản scrypt. Không commit secret này.
# Đổi giá trị rồi khởi động lại = xoay mật khẩu VÀ thu hồi mọi phiên Super Admin cũ.
# Nếu bỏ trống, Super Admin chỉ đăng nhập được qua OAuth phía server đã xác minh.
# Mật khẩu mẫu cũ đã bị vô hiệu hoá tự động.
FFORUM_ADMIN_PASSWORD=

# Khoá HMAC dùng ký token phiên. Nên đặt cố định ở môi trường thật để token
# không mất hiệu lực mỗi lần khởi động lại. Tối thiểu 16 ký tự.
FFORUM_SESSION_SECRET=

# Thư mục lưu dữ liệu (mặc định: ./data). Test dùng thư mục tạm riêng.
FFORUM_DATA_DIR=

# Credential OAuth phía MÁY CHỦ — dùng để tự kiểm chứng đăng nhập Google/Facebook.
# Không có chúng thì tài khoản vẫn đăng nhập social được ở chế độ demo,
# nhưng quyền Super Admin thì BẮT BUỘC phải xác minh thành công.
FFORUM_GOOGLE_CLIENT_ID=
FFORUM_FACEBOOK_APP_ID=
FFORUM_FACEBOOK_APP_SECRET=

# Đặt 1 NẾU server đứng sau reverse proxy (nginx, Cloudflare Tunnel...).
# Khi đó IP dùng cho rate limit lấy từ header X-Forwarded-For.
# Để trống (mặc định) thì dùng địa chỉ socket thật, client không giả được.
FFORUM_TRUST_PROXY=

# ---------------------------------------------------------------------------
# EPIC 5 — Header bảo mật, CORS, ảnh đại diện
# ---------------------------------------------------------------------------
# Nơi được phép nhúng site trong iframe ở bản production (CSP frame-ancestors).
# Mặc định chỉ cùng nguồn ('self'). Bản dev không chặn nhúng (khung xem trước).
# Ví dụ: FFORUM_FRAME_ANCESTORS='self' https://lms.truong.edu.vn
FFORUM_FRAME_ANCESTORS=

# Origin khác được gọi API (CORS), phân cách bằng dấu phẩy. Để trống = chỉ chính site.
FFORUM_ALLOWED_ORIGINS=

# CDN phục vụ ảnh đại diện/ảnh bìa đã xử lý (kéo từ /media/ của máy chủ).
# Phải là https. Để trống = phục vụ trực tiếp từ máy chủ (đã có cache immutable).
FFORUM_MEDIA_CDN_BASE=
