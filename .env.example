# OAuth client identifiers are public browser configuration. Never put provider
# client secrets in VITE_* variables; the API checks access-token audience and identity.
# Google OAuth 2.0 (Google Identity Services)
# Create a Web OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
# Set the same Google Web Client ID server-side to enforce OAuth token audience.
FFORUM_GOOGLE_CLIENT_ID=

# Meta / Facebook JavaScript SDK
# Create a Facebook App at https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=
# Server verifies both the token's Facebook app ID and token owner before login.
FFORUM_FACEBOOK_APP_ID=
FFORUM_FACEBOOK_APP_SECRET=

# Server-side account security. Set a unique high-entropy password (at least
# 16 characters) in the deployment environment. Leave blank to disable password
# login for the configured admin account; verified OAuth can still authenticate it.
FFORUM_ADMIN_EMAIL=anhtuantran0512@gmail.com
FFORUM_ADMIN_PASSWORD=

# Optional absolute path outside the project root for the server's private data.
# By default, account/forum data is stored at ~/.local/share/f-forum.
# Existing data/forum-data.json is migrated there automatically on first start.
# FFORUM_DATA_DIR=
