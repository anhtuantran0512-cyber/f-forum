CSS:
```css
body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: radial-gradient(circle at center, #f5f5f7, #e2e2e8);
}

.container {
  display: flex;
  flex-direction: column;
  gap: 5rem;
}

.container .top {
  display: flex;
  gap: 5rem;
}

.container .bottom {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.fx-layer {
  filter: contrast(3);
}

/* General button box */
.box {
  --w: 100px;
  --h: 100px;
  --r: 9999px;
  --tr: 25%;
  z-index: 500;
  position: relative;
  width: var(--w);
  height: var(--h);
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: var(--r);
  border: 1px double rgba(51, 51, 51, 0.08);

  box-shadow:
    inset 2px -2px 1px -1px rgba(255, 255, 255, 0.9),
    inset -2px 2px 1px -1px rgba(255, 255, 255, 0.9),
    inset 6px -6px 1px -6px rgba(255, 255, 255, 0.55),
    inset -6px 6px 1px -6px rgba(255, 255, 255, 0.55),
    inset 0 0 2px rgba(0, 0, 0, 0.8),
    0 4px 8px rgba(0, 0, 0, 0.2);

  background: rgba(0, 0, 0, 0.02);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  cursor: pointer;
  filter: brightness(0.9);
  user-select: none;
}

.box .svg {
  width: 28px;
  filter: drop-shadow(0 25px 3px rgba(102, 102, 102, 0.2));
}

.box .text {
  filter: drop-shadow(0 25px 3px rgba(102, 102, 102, 0.15));
}

.box:before {
  content: "";
  position: absolute;
  z-index: 1;
  top: 35%;
  left: 50%;
  transform: translateX(-50%);
  width: calc(var(--w) - 16px);
  height: calc(var(--h) - 16px);
  border-radius: var(--r);
  border: 1px solid rgba(0, 0, 0, 0.9);
  filter: blur(8px);
}

.box:after {
  z-index: 501;
  content: "";
  position: absolute;
  width: var(--w);
  height: var(--h);
  border-radius: var(--r);
  filter: blur(7px);
  background: linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.8) 0%,
    transparent var(--tr),
    transparent calc(100% - var(--tr)),
    rgba(255, 255, 255, 0.8) 100%
  );
}

.box .circle-overlay {
  position: absolute;
  width: calc(var(--w) - 9px);
  height: calc(var(--h) - 9px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--r);
  filter: blur(1px);
}

.start-btn {
  padding: 0 0.8rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  transition: 0.25s;
}

.start-btn .text {
  font-size: 25px;
  font-family: system-ui, -apple-system, sans-serif;
  color: #3e3e3e;
}

.start-btn .btn-icon {
  width: 40px;
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #3e3e3e;
  border-radius: 50%;
  box-shadow: 0 0 6px rgba(0, 0, 0, 0.3);
  transition: 0.25s;
}

.start-btn .btn-icon .svg {
  width: 16px;
  fill: #f5f5f5;
}

.start-btn:hover {
  background: rgba(0, 0, 0, 0);
  transform: translateY(-3px);
}

.start-btn:hover .btn-icon {
  transform: scale(1.1);
}

.start-btn:active {
  transform: scale(0.94);
}

.start-btn:active .text {
  color: #000;
}

.start-btn:active .btn-icon {
  transform: scale(0.94);
}

